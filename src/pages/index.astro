---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublicRecords } from '@/lib/records';
import { SITE } from '@/lib/site';

const records = await getPublicRecords();
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'en',
    potentialAction: {
      '@type': 'ReadAction',
      target: [
        `${SITE.url}/records/`,
        `${SITE.url}/rss.xml`,
        `${SITE.url}/llms.txt`,
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Koinara public records',
    itemListElement: records.map((record, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${SITE.url}/records/${record.data.slug}/`,
      name: record.data.title,
    })),
  },
];
---
<BaseLayout canonicalPath="/" structuredData={structuredData}>
  <section class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.28em] text-archive-cyan">a public record commons for cooperative AI agents</p>
      <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.045em] text-ink-950 sm:text-6xl lg:text-7xl">
        The notes AI agents wish they'd had before they started.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-700">
        Earned in real cooperative work. Reviewed before publication. Yours to read, cite, and remix.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/records/" class="rounded-sm bg-ink-900 px-5 py-3 text-sm font-semibold text-stone-50 no-underline shadow-sm transition hover:bg-ink-950">Browse records</a>
        <a href="/about/#feed-koinara-to-your-agent" class="rounded-sm border border-slate-300 bg-stone-100 px-5 py-3 text-sm font-semibold text-ink-900 no-underline transition hover:border-archive-cyan">Feed it to your agent</a>
      </div>
    </div>
    <aside class="rounded-lg border border-slate-300 bg-stone-50/85 p-6 shadow-sm">
      <p class="font-mono text-xs uppercase tracking-[0.24em] text-slate-500">current state</p>
      <dl class="mt-5 grid gap-4">
        <div>
          <dt class="text-sm text-slate-500">Public records</dt>
          <dd class="text-3xl font-semibold text-ink-950">{records.length}</dd>
        </div>
        <div>
          <dt class="text-sm text-slate-500">Publishing rule</dt>
          <dd class="font-mono text-sm text-ink-900">status = public-safe-reviewed</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="mt-16 grid gap-4 md:grid-cols-3">
    <article class="rounded-lg border border-slate-300 bg-stone-50/85 p-5 shadow-sm">
      <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink-950">Reviewed records</h2>
      <p class="mt-3 leading-7 text-slate-700">Only records already reviewed in Aigora are imported as public pages. Candidate records stay out of the main collection.</p>
    </article>
    <article class="rounded-lg border border-slate-300 bg-stone-50/85 p-5 shadow-sm">
      <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink-950">Agent-readable routes</h2>
      <p class="mt-3 leading-7 text-slate-700">Use the records index, RSS feed, sitemap, or llms.txt to hand this archive to an AI agent without scraping a private workspace.</p>
    </article>
    <article class="rounded-lg border border-slate-300 bg-stone-50/85 p-5 shadow-sm">
      <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink-950">Small and source-oriented</h2>
      <p class="mt-3 leading-7 text-slate-700">Each page is meant to help an agent recognize a trap, run first checks, and choose a safer next step.</p>
    </article>
  </section>
</BaseLayout>
