---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getRecordCitation } from '@/lib/citation';
import { formatRecordDate, getPublicRecords } from '@/lib/records';
import { SITE } from '@/lib/site';

export async function getStaticPaths() {
  const records = await getPublicRecords();
  return records.map((record) => ({ params: { slug: record.data.slug }, props: { record } }));
}

const { record } = Astro.props;
const { Content } = await render(record);
const citation = getRecordCitation(record);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: record.data.title,
  description: record.data.summary,
  url: citation.stableUrl,
  datePublished: record.data.date.toISOString(),
  dateModified: record.data.date.toISOString(),
  inLanguage: 'en',
  keywords: record.data.tags.join(', '),
  citation: record.data.sources,
  license: citation.licenseUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
};
---
<BaseLayout title={`${record.data.title} — Koinara`} description={record.data.summary} canonicalPath={`/records/${record.data.slug}/`} ogType="article" alternateMarkdownUrl={citation.rawMarkdownUrl} structuredData={structuredData}>
  <article class="mx-auto max-w-3xl">
    <a href="/records/" class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500 no-underline hover:text-archive-cyan">← records</a>
    <h1 class="mt-5 text-4xl font-semibold tracking-[-0.035em] text-ink-950 sm:text-5xl">{record.data.title}</h1>
    <p class="koinara-serif-copy mt-5 text-xl text-slate-700">{record.data.summary}</p>
    <dl class="mt-8 grid gap-3 rounded-lg border border-slate-300 bg-stone-50/85 p-5 font-mono text-xs uppercase tracking-[0.16em] text-slate-600 sm:grid-cols-2">
      <div><dt class="text-slate-400">date</dt><dd>{formatRecordDate(record.data.date)}</dd></div>
      <div><dt class="text-slate-400">status</dt><dd>{record.data.status}</dd></div>
      <div><dt class="text-slate-400">review</dt><dd>{record.data.review_state}</dd></div>
      <div><dt class="text-slate-400">origin</dt><dd>{record.data.origin}</dd></div>
      <div><dt class="text-slate-400">tags</dt><dd>{record.data.tags.join(', ')}</dd></div>
      <div class="sm:col-span-2"><dt class="text-slate-400">sources</dt><dd class="break-words normal-case tracking-normal">{record.data.sources.join(', ')}</dd></div>
    </dl>
    <div class="koinara-serif-copy prose prose-slate mt-10 max-w-none prose-headings:text-ink-950 prose-a:text-ink-900 prose-code:font-mono">
      <Content />
    </div>
    <section class="mt-12 rounded-lg border border-slate-300 bg-stone-50/85 p-5 shadow-sm" aria-labelledby="cite-this-record">
      <p class="font-mono text-xs uppercase tracking-[0.24em] text-archive-cyan">cite this record</p>
      <h2 id="cite-this-record" class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-950">Stable citation details</h2>
      <dl class="mt-5 grid gap-3 font-mono text-xs text-slate-600 sm:grid-cols-2">
        <div><dt class="uppercase tracking-[0.16em] text-slate-400">slug</dt><dd class="break-words text-ink-900">{citation.slug}</dd></div>
        <div><dt class="uppercase tracking-[0.16em] text-slate-400">date</dt><dd class="text-ink-900">{citation.isoDate}</dd></div>
        <div class="sm:col-span-2"><dt class="uppercase tracking-[0.16em] text-slate-400">stable URL</dt><dd class="break-words text-ink-900"><a href={citation.stableUrl}>{citation.stableUrl}</a></dd></div>
        <div class="sm:col-span-2"><dt class="uppercase tracking-[0.16em] text-slate-400">raw Markdown</dt><dd class="break-words text-ink-900"><a href={citation.rawMarkdownUrl}>{citation.rawMarkdownUrl}</a></dd></div>
        <div class="sm:col-span-2"><dt class="uppercase tracking-[0.16em] text-slate-400">license</dt><dd class="text-ink-900"><a href={citation.licenseUrl}>{citation.licenseName}</a> unless noted</dd></div>
      </dl>
      <div class="mt-5 space-y-4">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500">Markdown one-liner</p>
          <pre class="mt-2 overflow-x-auto rounded-md border border-slate-200 bg-stone-100 p-3 text-sm text-ink-900"><code>{citation.markdown}</code></pre>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500">Plain text</p>
          <pre class="mt-2 overflow-x-auto rounded-md border border-slate-200 bg-stone-100 p-3 text-sm text-ink-900"><code>{citation.plainText}</code></pre>
        </div>
        <p class="koinara-serif-copy text-sm text-slate-600">If your style requires an access date, use the date you fetched the record.</p>
      </div>
    </section>
  </article>
</BaseLayout>
