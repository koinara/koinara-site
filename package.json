{
  "name": "koinara-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "lint:public": "tsx scripts/lint-public-content.ts",
    "check": "astro check && npm run lint:public",
